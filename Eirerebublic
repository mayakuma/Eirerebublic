    </div>
      <div class="contact_us_form">
        <input required="" placeholder="Name *" type="text" class="input">
        <input required="" placeholder="Last Name *" type="text" class="input">
      </div>  

      <input required="" placeholder="E-mail *" type="email" class="input">
      <textarea spellcheck="false" placeholder="Message" required></textarea>
      <div class="contact_us_btn">
        <button>Send</button>
      </div>
    </form>
   <div class="contact_us_second_colm">
      <div class="contact_us_Sec_img_box">
      <img src="img/contact us 1.png">
    </div>
    <div class="contact_us_second_img">
      <img src="img/about bg 2 1.png">
    </div>
   </div>
  </div>
</div>
